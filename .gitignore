# Dependencies
node_modules/
.pnpm-store/

# Environment files
.env
.env.*
!.env.example
!.env.production.example
!VPS/.env.production.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build/runtime output
dist/
build/
coverage/
.cache/
.tmp/
.tmp-*/
temp/
out/

# PM2
.pm2/
pids/
*.pid
*.pid.lock
*.seed

# OS/Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Project runtime data
VPS/backend/uploads/
VPS/backend/src/database/json/*.json
VPS/backend/src/database/json/*.bak*
VPS/backend/src/database/json/*.tmp
!VPS/backend/src/database/json/.gitkeep

# WhatsApp (Baileys) session — contains device encryption keys, never commit
VPS/backend/src/database/whatsapp-session/

# Portable image-assets folder (not in git — move this folder to migrate servers)
VPS/image-assets/uploads/*
VPS/image-assets/migration/*
VPS/image-assets/print-uploads/*
!VPS/image-assets/.gitkeep
!VPS/image-assets/uploads/.gitkeep
!VPS/image-assets/migration/.gitkeep
!VPS/image-assets/print-uploads/.gitkeep
