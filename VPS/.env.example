# Runtime
NODE_ENV=development
PORT=4100
API_BASE_URL=http://localhost:4100

# Security/Auth placeholders (Phase 2)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ALLOW_HEADER_AUTH_FALLBACK=false
OTP_DEV_DEFAULT_CODE=123456
CART_STOCK_RESERVATION_MINUTES=15

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/jenix_commerce
CATALOG_STORE_PATH=backend/src/database/json/catalog-store.json
PAYMENT_STORE_PATH=backend/src/database/json/payment-store.json
RECOVERY_STORE_PATH=backend/src/database/json/recovery-store.json
INVOICE_STORE_PATH=backend/src/database/json/invoice-store.json
SHIPPING_STORE_PATH=backend/src/database/json/shipping-store.json
SEARCH_STORE_PATH=backend/src/database/json/search-store.json
CONTENT_STORE_PATH=backend/src/database/json/content-store.json
WEBSITE_LEADS_STORE_PATH=backend/src/database/json/website-leads-store.json
MARKETING_STORE_PATH=backend/src/database/json/marketing-store.json

# File storage
PUBLIC_BASE_URL=http://localhost:4100
UPLOAD_DIR=backend/uploads

# Admin seed placeholders
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Future provider adapters (keep empty until implemented)
PAYMENT_PROVIDER=
SHIPPING_PROVIDER=
OTP_PROVIDER=
EMAIL_PROVIDER=
ANALYTICS_PROVIDER=
