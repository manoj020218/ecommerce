{
  "name": "jenix-commerce-vps",
  "private": true,
  "version": "0.1.0",
  "description": "Jenix Commerce monorepo in VPS folder (pnpm + PM2)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:backend": "node --watch backend/src/server.js",
    "start:backend": "node backend/src/server.js",
    "dev:admin": "pnpm --filter @jenix/admin-panel dev",
    "dev:front": "pnpm --filter @jenix/front dev",
    "build:admin": "pnpm --filter @jenix/admin-panel build",
    "build:front": "pnpm --filter @jenix/front build",
    "preview:front:4174": "node apps/front/static-preview-server.cjs 4174",
    "check:backend": "node backend/src/checks/run-regression-checks.js",
    "test:backend": "jest",
    "test:backend:watch": "jest --watch",
    "test:backend:coverage": "jest --coverage",
    "test:admin": "pnpm --filter @jenix/admin-panel test",
    "test:admin:coverage": "pnpm --filter @jenix/admin-panel test:coverage",
    "test": "pnpm run test:backend && pnpm run test:admin",
    "lint": "eslint backend/src",
    "format:check": "prettier --check \"**/*.{js,json,md,yaml,yml}\"",
    "format": "prettier --write \"**/*.{js,json,md,yaml,yml}\"",
    "pm2:start": "pm2 start ecosystem.config.cjs --only jenix-backend",
    "pm2:restart": "pm2 restart jenix-backend",
    "pm2:stop": "pm2 stop jenix-backend",
    "pm2:logs": "pm2 logs jenix-backend",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "express-rate-limit": "^7.5.0",
    "nodemailer": "^6.10.1",
    "razorpay": "^2.9.6",
    "sharp": "^0.34.5",
    "zod": "^4.0.17"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp", "esbuild", "unrs-resolver"]
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "pm2": "^7.0.1",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2"
  }
}
