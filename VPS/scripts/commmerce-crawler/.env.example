# ── Required ──────────────────────────────────────────────────────────────────
# The public URL of the commmerce.com store you want to migrate.
SITE_URL=https://yourstore.com

# ── Optional tweaks ────────────────────────────────────────────────────────────
# Milliseconds to wait between page requests (default 1500).
# Increase to 3000+ if the site rate-limits you.
REQUEST_DELAY_MS=1500

# How many Playwright pages to open in parallel (default 2).
# Keep at 2; raising it risks getting blocked.
CONCURRENCY=2

# Max retries per product page before marking it failed (default 3).
MAX_RETRIES=3

# Output directories (defaults shown).
OUTPUT_DIR=./output
IMAGE_DIR=./output/images
