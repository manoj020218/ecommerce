# Target site
SITE_URL=https://jenixindia.com

# Optional: admin panel cookie if you want to fetch via admin session
# ADMIN_COOKIE=

# Rate limiting (ms between requests)
REQUEST_DELAY_MS=1500

# Max concurrent page loads
CONCURRENCY=2

# Output directory
OUTPUT_DIR=./output

# Image output directory
IMAGE_DIR=./output/images

# Max retries per URL
MAX_RETRIES=3
