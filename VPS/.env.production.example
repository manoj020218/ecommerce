# ============================================================
#  Jenix Commerce — Production .env
#  Copy to .env on the VPS and fill in real values.
#  Never commit .env to git.
# ============================================================

# Runtime
NODE_ENV=production
PORT=4100
API_BASE_URL=https://api.jenixindia.com
PUBLIC_BASE_URL=https://api.jenixindia.com

# Security/Auth  (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=REPLACE_WITH_64_HEX_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_64_HEX_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ALLOW_HEADER_AUTH_FALLBACK=false
OTP_DEV_DEFAULT_CODE=123456
CART_STOCK_RESERVATION_MINUTES=15

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=https://jenixindia.com,https://www.jenixindia.com,https://admin.jenixindia.com

# Image storage — self-contained folder, move this entire folder to migrate servers
# On production: keep as image-assets/* so the whole project is portable
UPLOAD_DIR=image-assets/uploads
MIGRATION_IMAGES_DIR=image-assets/migration

# Database file paths (relative to VPS/ working directory)
CATALOG_STORE_PATH=backend/src/database/json/catalog-store.json
PAYMENT_STORE_PATH=backend/src/database/json/payment-store.json
RECOVERY_STORE_PATH=backend/src/database/json/recovery-store.json
INVOICE_STORE_PATH=backend/src/database/json/invoice-store.json
SHIPPING_STORE_PATH=backend/src/database/json/shipping-store.json
SEARCH_STORE_PATH=backend/src/database/json/search-store.json
CONTENT_STORE_PATH=backend/src/database/json/content-store.json
WEBSITE_LEADS_STORE_PATH=backend/src/database/json/website-leads-store.json
MARKETING_STORE_PATH=backend/src/database/json/marketing-store.json

# Super admin (used only once by: node scripts/seed-admin.js)
# Change the password immediately after first login via Admin → Staff
SUPER_ADMIN_EMAIL=admin@jenixindia.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Provider adapters — leave blank, configured via Admin → Setup Wizard / Payment Gateways
# Razorpay and Cashfree credentials are stored in payment-store.json via the admin UI.
# SMTP credentials are stored in settings.json via Setup Wizard → SMTP Email.
PAYMENT_PROVIDER=
SHIPPING_PROVIDER=
OTP_PROVIDER=
EMAIL_PROVIDER=
ANALYTICS_PROVIDER=
